server {
    listen 443 ssl;
    server_name web.lab.test;

    ssl_certificate     /etc/nginx/tls/web.lab.test.crt;
    ssl_certificate_key /etc/nginx/tls/web.lab.test.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        default_type text/plain;
        return 200 "HTTPS lab online\n";
    }
}
